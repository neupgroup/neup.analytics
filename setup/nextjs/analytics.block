import crypto from "node:crypto";
import { cookies, headers } from "next/headers";

function projectSecret(): Buffer {
  const secret = process.env.NEUP_ANALYTICS_PROJECT_KEY;
  if (!secret || !/^[a-f0-9]{64}$/.test(secret)) throw new Error("Configure NEUP_ANALYTICS_PROJECT_KEY with a generated project secret.");
  return Buffer.from(secret, "hex");
}
function generateContextId(traceId: string): string {
  return crypto.createHmac("sha256", projectSecret()).update(traceId).digest("hex");
}
function signContextId(contextId: string): string {
  const signature = crypto.createHmac("sha256", projectSecret()).update("neup-context:v1:" + contextId).digest("hex");
  return "v1." + contextId + "." + signature;
}

function generateTraceId(): string { return crypto.randomBytes(32).toString("hex"); }

/**
 * Gets the existing analytics trace cookie.
 * The cookie is created by middleware/proxy, because Server Components (including
 * the root layout) can read cookies but cannot modify the response headers.
 *
 * Server-side only.
 */
export async function getAnalyticsContext() {
  const cookieStore = await cookies();

  let traceId = cookieStore.get("_neuptraceid")?.value;

  if (!traceId) traceId = generateTraceId();

  const contextId = generateContextId(traceId);
  const signedContextId = signContextId(contextId);

  return {
    traceId,
    contextId,
    signedContextId,
  };
}

/**
 * Logs a page activity from the server.
 *
 * The _neuptraceid cookie is included only when it exists.
 */
export async function logPageActivity(
  projectId: string,
  contextId: string,
  pageUrl: string
): Promise<void> {
  const projectKey = process.env.NEUP_ANALYTICS_PROJECT_KEY;

  if (!projectKey) {
    return;
  }

  const requestHeaders = await headers();
  const cookieStore = await cookies();

  const traceId =
    cookieStore.get("_neuptraceid")?.value;

  const agent =
    requestHeaders.get("user-agent") ?? "";

  const forwardedFor =
    requestHeaders.get("x-forwarded-for");

  const ipAddress =
    forwardedFor?.split(",")[0]?.trim() ||
    requestHeaders.get("x-real-ip") ||
    "";

  const body: {
    _neuptraceid?: string;
    contextId: string;
    pageUrl: string;
    agent: string;
    ipAddress: string;
  } = {
    contextId: signContextId(contextId),
    pageUrl,
    agent,
    ipAddress,
  };

  if (traceId) {
    body._neuptraceid = traceId;
  }

  try {
    await fetch(
      `https://neupgroup.com/analytics/bridge/api.v1/activity?project=${encodeURIComponent(projectId)}`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
        cache: "no-store",
      }
    );
  } catch {
    // Analytics failures must never break the application.
  }
}

/**
 * Logs a generic server-side activity.
 *
 * Examples:
 * - button_press
 * - form_submit
 * - login
 * - logout
 * - property_view
 * - property_contact
 * - search
 * - signup
 */
export async function logActivity(
  projectId: string,
  activity: string,
  data?: Record<string, unknown>
): Promise<void> {
  if (!process.env.NEUP_ANALYTICS_PROJECT_KEY) {
    return;
  }

  const requestHeaders = await headers();
  const cookieStore = await cookies();

  const traceId =
    cookieStore.get("_neuptraceid")?.value;

  /*
   * The Context ID is derived from the server-side
   * trace ID, so server activities remain connected
   * to the same browsing context.
   */
  const contextId = traceId
    ? generateContextId(traceId)
    : null;

  const agent =
    requestHeaders.get("user-agent") ?? "";

  const forwardedFor =
    requestHeaders.get("x-forwarded-for");

  const ipAddress =
    forwardedFor?.split(",")[0]?.trim() ||
    requestHeaders.get("x-real-ip") ||
    "";

  const body: {
    _neuptraceid?: string;
    contextId?: string;
    projectId: string;
    event: string;
    url: string;
    path: string;
    referrer: string;
    timestamp: string;
    userAgent: string;
    ipAddress: string;
    geoLocation?: string;
    data?: Record<string, unknown>;
  } = {
    projectId,
    event: activity,
    url: typeof data?.url === "string" ? data.url : requestHeaders.get("referer") ?? "",
    path: typeof data?.path === "string" ? data.path : typeof data?.pagePath === "string" ? data.pagePath : "",
    referrer: requestHeaders.get("referer") ?? "",
    timestamp: new Date().toISOString(),
    userAgent: agent,
    ipAddress,
  };

  /*
   * Only include the trace ID when the cookie exists.
   */
  if (traceId) {
    body._neuptraceid = traceId;
  }

  /*
   * Only include a Context ID when there is a trace
   * cookie from which it can be derived.
   */
  if (contextId) {
    body.contextId = signContextId(contextId);
  }

  if (data !== undefined) {
    body.data = data;
  }

  try {
    await fetch(
      `https://neupgroup.com/analytics/bridge/api.v1/activity?project=${encodeURIComponent(projectId)}`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(body),
        cache: "no-store",
      }
    );
  } catch {
    /*
     * Analytics must never break the application.
     */
  }
}
