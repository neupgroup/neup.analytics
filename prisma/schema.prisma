// Prisma schema for the relational PostgreSQL analytics model.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./output"
}

datasource db {
  provider = "postgresql"
}

model PageSnapshot {
  id           String        @id @default(cuid())
  pagePath     String
  siteId       String
  content      String
  version      Int           @default(1)
  recordedOn   DateTime      @default(now())
  interactions Interaction[]

  @@index([pagePath])
  @@index([siteId])
}

model User {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastSeen        DateTime?
  pagePath        String?
  isLive          Boolean       @default(false)
  lastInteraction Json?
  interactions    Interaction[]

  @@index([isLive])
}

model Interaction {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  userId       String?
  pageId       String?
  pagePath     String
  windowWidth  Int
  windowHeight Int
  userAgent    String?
  ip           String?
  city         String?
  region       String?
  country      String?
  latitude     Float?
  longitude    Float?
  page         PageSnapshot?      @relation(fields: [pageId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  events       InteractionEvent[]
  snapshotWebs SnapshotWeb[]

  @@index([createdAt])
  @@index([pageId])
  @@index([userId])
}

model SnapshotWeb {
  id        String       @id @default(cuid())
  sessionId String?      @map("session_id")
  pageUrl   String
  data      String
  details   Json?
  createdOn DateTime     @default(now()) @map("created_on")
  session   Interaction? @relation(fields: [sessionId], references: [id])

  @@index([createdOn])
  @@index([pageUrl])
  @@index([sessionId])
  @@map("snapshotWeb")
}

model InteractionEvent {
  id            String               @id @default(cuid())
  interactionId String
  type          InteractionEventType
  x             Int?
  y             Int?
  scrollX       Int?
  scrollY       Int?
  element       String?
  value         String?
  key           String?
  timestamp     Int
  interaction   Interaction          @relation(fields: [interactionId], references: [id])

  @@index([interactionId])
}

model Application {
  id      String            @id @default(cuid())
  name    String
  sites   String[]
  details String?
  status  ApplicationStatus @default(setup)
}

model Account {
  id           String   @id
  connectionId String
  type         String
  displayName  String
  displayImage String
  createdOn    DateTime @default(now())
  status       String
  moreDetails  Json?
}

model Activity {
  id           String   @id @default(cuid())
  identifierId String
  type         String?
  sessionId    String?
  timeSpent    Int?
  agent        Json?
  location     Json?
  moreDetails  Json?
  ip           String?
  userAgent    String?
  pageUrl      String?
  referral     String?
  activityOn   DateTime @default(now())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])

  @@index([identifierId])
  @@index([type])
  @@index([sessionId])
  @@index([projectId])
  @@index([activityOn])
  @@index([pageUrl])
}

model Project {
  id          String   @id @default(cuid())
  path        String
  type        String
  moreDetails Json?
  token       String   @unique
  createdOn   DateTime @default(now())

  activities Activity[]
}

enum InteractionEventType {
  mousemove
  click
  scroll
  touch
  input
  keydown
  pageview
  heartbeat
}

enum ApplicationStatus {
  setup
  active
}
